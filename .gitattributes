# 文本统一 LF；PowerShell 脚本保持 CRLF（Windows PowerShell 5.1 友好）。
* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf

# Content-addressed assets must keep identical bytes on Windows and CI.
webui/* text eol=lf
dist/* text eol=lf
scripts/*.mjs text eol=lf
# Attribution hashes use original SVG bytes; do not convert their line endings.
world/stationery/*.svg -text
