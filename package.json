{
  "name": "cortico-world-bottle",
  "version": "0.8.2",
  "type": "module",
  "description": "桌宠起草漂流瓶与小纸条，人确认寄出；共读、回信与星笺记忆分别授权。",
  "keywords": [
    "cortico-world",
    "cortico",
    "letter",
    "bottle",
    "anonymous-letter"
  ],
  "license": "MIT",
  "author": "云纪",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unnori/cortico-world-bottle-client.git"
  },
  "homepage": "https://github.com/Unnori/cortico-world-bottle-client#readme",
  "bugs": {
    "url": "https://github.com/Unnori/cortico-world-bottle-client/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./world/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "漂流瓶",
    "icon": "world/icon.png",
    "describe": "describe.json",
    "tags": [
      "experimental"
    ],
    "locales": {
      "zh": {
        "displayName": "漂流瓶",
        "description": "桌宠起草漂流瓶与小纸条，人确认寄出；共读、回信与星笺记忆分别授权。"
      },
      "en": {
        "displayName": "Message in a Bottle",
        "description": "Companion-written letters and short notes, human-confirmed sending, separate read/reply intent and revocable starred-letter memory."
      }
    },
    "webUiClient": "dist/webui-e3fcf534a3ac.js",
    "webUiStyle": "dist/webui-152172be2ee1.css"
  },
  "files": [
    "world",
    "dist/webui-e3fcf534a3ac.js",
    "dist/webui-152172be2ee1.css",
    "shared/contract.ts",
    "shared/text.ts",
    "shared/hints.ts",
    "shared/ago.ts",
    "describe.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "server": "tsx server/main.ts",
    "dev:mailbox": "tsx dev/mailbox.ts",
    "build:webui": "node scripts/build-webui.mjs",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "prepack": "npm run typecheck:web && node scripts/check-font-package.mjs && npm run build:webui",
    "check:running-webui": "node scripts/check-running-webui.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "cortico": "^0.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
