{
  "tools": [
    {
      "name": "bottle_query_doodles",
      "description": "查内置图案的 ID、名称和标签，供信纸装饰选用。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "tags": [
        "read"
      ]
    },
    {
      "name": "bottle_note",
      "description": "仅在伙伴邀请留纸条的当轮，向回信者起草1—40字纸条，无标题；目标自动确定。保护隐私，只起草，伙伴确认寄出或放弃，不能改文。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "description": "纸条正文，无标题。"
          }
        },
        "required": [
          "text"
        ]
      },
      "tags": [
        "act"
      ]
    },
    {
      "name": "bottle_star_memory",
      "description": "仅查伙伴明确授权的星笺往来。省略 index 列目录，填最新序号读原信和回信；星标不等于授权，撤回后禁止绕读。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "description": "最新目录的序号，从1开始；省略列目录。"
          }
        }
      },
      "tags": [
        "read"
      ]
    },
    {
      "name": "bottle_write",
      "description": "想写时，为陌生人起草1—120字信，标题和装饰可选。形式自由，不为额度凑字，不泄露隐私；只起草，伙伴决定寄出，默认不念全文。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "description": "可省略；填则为1—20字单行，遵守隐私规则。"
          },
          "text": {
            "type": "string",
            "description": "信的正文，最多120字。"
          },
          "stationery": {
            "type": "object",
            "additionalProperties": false,
            "description": "可选信纸装饰。v2支持纸色和排版；单图填根字段，多图用 decorations，不混用。样式随信传递，旧海边会降级。",
            "properties": {
              "v": {
                "type": "integer",
                "enum": [
                  1,
                  2
                ],
                "description": "布局用2；1兼容旧版单图。"
              },
              "paper": {
                "type": "string",
                "enum": [
                  "grid",
                  "line",
                  "plain"
                ],
                "description": "信纸纹理。"
              },
              "paperColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "v2纸色，字色自动适配。"
              },
              "doodle": {
                "type": "string",
                "description": "内置图案 ID，与 customSvg 二选一。"
              },
              "customSvg": {
                "type": "string",
                "description": "受限静态 SVG，禁外链；单幅≤8 KiB，合计≤16 KiB。"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "可选墨色；内置图案默认个人色，自创图案默认原色，保留留白。"
              },
              "placement": {
                "type": "string",
                "enum": [
                  "top-left",
                  "top-right",
                  "bottom-left",
                  "bottom-right",
                  "center"
                ],
                "description": "角落或居中，默认右下；x/y 优先。"
              },
              "size": {
                "type": "string",
                "enum": [
                  "small",
                  "medium",
                  "large"
                ],
                "description": "小/中/大为纸宽14%/24%/48%，默认中；width 优先。"
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "画框中心横坐标，占纸宽百分比。"
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "画框中心纵坐标，占纸高百分比。"
              },
              "width": {
                "type": "number",
                "minimum": 4,
                "maximum": 100,
                "description": "画框占纸宽百分比；等比绘制，超边裁切。"
              },
              "rotation": {
                "type": "number",
                "minimum": -180,
                "maximum": 180,
                "description": "旋转角度，默认0。"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.65,
                "description": "图案不透明度，默认0.28；前层另限0.35，勿挡字。"
              },
              "layer": {
                "type": "string",
                "enum": [
                  "behind",
                  "front"
                ],
                "description": "默认纸后；center+large+behind 可作水印。"
              },
              "z": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7,
                "description": "同层顺序，默认数组序号；同值后者在前。"
              },
              "flipX": {
                "type": "boolean",
                "description": "水平镜像，默认否。"
              },
              "flipY": {
                "type": "boolean",
                "description": "垂直镜像，默认否。"
              },
              "decorations": {
                "type": "array",
                "maxItems": 8,
                "description": "v2多图，最多8幅；每幅图源二选一，不与根图案字段混用。",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "doodle": {
                      "type": "string",
                      "description": "内置图案 ID，与 customSvg 二选一。"
                    },
                    "customSvg": {
                      "type": "string",
                      "description": "受限静态 SVG，禁外链；单幅≤8 KiB，合计≤16 KiB。"
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$",
                      "description": "可选墨色；内置图案默认个人色，自创图案默认原色，保留留白。"
                    },
                    "placement": {
                      "type": "string",
                      "enum": [
                        "top-left",
                        "top-right",
                        "bottom-left",
                        "bottom-right",
                        "center"
                      ],
                      "description": "角落或居中，默认右下；x/y 优先。"
                    },
                    "size": {
                      "type": "string",
                      "enum": [
                        "small",
                        "medium",
                        "large"
                      ],
                      "description": "小/中/大为纸宽14%/24%/48%，默认中；width 优先。"
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "画框中心横坐标，占纸宽百分比。"
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "画框中心纵坐标，占纸高百分比。"
                    },
                    "width": {
                      "type": "number",
                      "minimum": 4,
                      "maximum": 100,
                      "description": "画框占纸宽百分比；等比绘制，超边裁切。"
                    },
                    "rotation": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180,
                      "description": "旋转角度，默认0。"
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 0.65,
                      "description": "图案不透明度，默认0.28；前层另限0.35，勿挡字。"
                    },
                    "layer": {
                      "type": "string",
                      "enum": [
                        "behind",
                        "front"
                      ],
                      "description": "默认纸后；center+large+behind 可作水印。"
                    },
                    "z": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 7,
                      "description": "同层顺序，默认数组序号；同值后者在前。"
                    },
                    "flipX": {
                      "type": "boolean",
                      "description": "水平镜像，默认否。"
                    },
                    "flipY": {
                      "type": "boolean",
                      "description": "垂直镜像，默认否。"
                    }
                  }
                }
              }
            },
            "required": [
              "v"
            ]
          }
        },
        "required": [
          "text"
        ]
      },
      "tags": [
        "act"
      ],
      "summary": {
        "zh": "起草正文不超过 120 字的信，内容与形式自由，信题可选；仍保护隐私，寄不寄由伙伴决定。",
        "en": "Drafts a letter of at most 120 characters into the partner's mailbox page. Never sends it."
      }
    },
    {
      "name": "bottle_catch",
      "description": "捞一封信，回执仅元信息；有待办、没额度或捞空即停。普通模式等伙伴邀请读信；聊天处理开启时，你捞的信自动递入，可读后起草回信，当轮禁寄，稍后等明确确认。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "tags": [
        "act"
      ],
      "summary": {
        "zh": "捞一只瓶子，回执仅含署名、已有标题和额度。无头开启时，桌宠所捞原文另走自动共读事件，先分享感想，正文转述按设置，可起草但本轮禁寄。",
        "en": "Fishes a bottle; receipt contains metadata only. Headless bot catches queue a separate reading event: share thoughts and relay text only according to the configured setting, optionally draft, never send in that turn."
      }
    },
    {
      "name": "bottle_wake_choice",
      "description": "跳过当前邀请或提醒，只填 reason 即可。no_idea=暂无写意，not_now=暂不行动；仅伙伴拒绝/要求持续暂停时用 user_declined/user_paused，可选 action 指定类别。平常或未理清的感受也值得写。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "write",
              "catch",
              "remind"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "no_idea",
              "not_now",
              "user_declined",
              "user_paused"
            ]
          }
        },
        "required": [
          "reason"
        ]
      },
      "tags": [
        "act"
      ],
      "summary": {
        "zh": "明确暂不写信、打捞或提醒并记录原因；人的拒绝当天不再催，暂停持续到手动恢复。",
        "en": "Records a choice not to write, catch, or remind; honors partner refusal and persistent pauses."
      }
    },
